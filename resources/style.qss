/* ---------------------------------------------------------------------
   Bảng màu HỒNG PASTEL v3 — bản DỊU NHẸ (giảm độ bão hoà so với v2 để
   bớt chói, giữ cảm giác đáng yêu, ấm áp):
     --bg          #F6D8E4   nền cửa sổ (hồng phấn dịu, đậm hơn card 1 chút
                              nhưng bão hoà thấp nên không gắt mắt)
     --card        #FFF6F9   nền card / sidebar / topbar / bảng (gần trắng,
                              ánh hồng rất nhẹ)
     --card-2      #FCE9F0   nền input / nút ghost / hover / hàng xen kẽ
     --border      #F8DCE8   viền nhạt
     --border-s    #F3C6D9   viền đậm hơn
     --primary     #EA8FAE   nút chính / nav active / focus (đủ đậm cho chữ
                              trắng nhưng vẫn mềm)
     --primary-hov #F2A8C2
     --primary-prs #D66A8C   pressed / dùng làm màu chữ-icon primary trên nền sáng
     --text        #6B4557   chữ chính (nâu mận ấm, dịu hơn bản trước)
     --text-dim    #B58CA0
     --text-faint  #DCC0CE
     --lavender    #C9AEE8   accent phụ (avatar, icon purple)
     --lavender-txt#9B72D1
     --mint (success) bg #DFF5EC / text #4FA98A
     --peach (warning/booked) bg #FCE7D3 / text #D9915C
     --coral (danger/maintenance) bg #FBE1DC / text #C96257
     --gold (rank #1) giữ nguyên, đã dịu sẵn
   Qt Style Sheets KHÔNG hỗ trợ box-shadow / border-radius theo %.
   Đổ bóng cho card -> dùng QGraphicsDropShadowEffect trong code (xem
   HUONG_DAN_TICH_HOP_QT.md, mục 4).
   ===================================================================== */

* {
    font-family: "Inter", "Segoe UI", sans-serif;
    color: #6B4557;
    outline: none;
}

QMainWindow, QWidget#centralWidget {
    background-color: #F6D8E4;
}

/* ------------------------------------------------------------------ */
/* SIDEBAR (thay cho QTabWidget mặc định)                              */
/* LUU Y: selector dung QWidget#sidebarWrap vi trong MainWindow.cpp     */
/* widget cha thuc te co objectName la "sidebarWrap" (QWidget), khong   */
/* phai "sidebar" (QFrame). Rule nay lam nen trang + duong line phai   */
/* chay LIEN TUC suot ca vung brandBlock lan sidebarNav ben trong,      */
/* giup logo/ten app va thanh dieu huong nhin lien thanh 1 khoi trang,  */
/* giong ban mockup web tham khao.                                     */
/* ------------------------------------------------------------------ */
QWidget#sidebarWrap {
    background-color: #FFF6F9;
    border-right: 0.5px solid #F8DCE8;
}

QLabel#brandMark {
    border-radius: 10px;
    background-color: #EA8FAE; /* fallback phẳng, gradient thật set bằng code nếu muốn */
    color: #FFFFFF;
    font-weight: 700;
}

QLabel#brandName {
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-weight: 700;
    font-size: 15px;
    color: #6B4557;
}

QLabel#brandSub {
    font-size: 11px;
    color: #DCC0CE;
}

QLabel[role="navLabel"] {
    font-size: 11px;
    font-weight: 700;
    color: #DCC0CE;
    padding: 10px 4px 2px;
}

/* Nav item = QPushButton (checkable, flat) */
QPushButton[role="navItem"] {
    text-align: left;
    background-color: transparent;
    color: #B58CA0;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 10px;
    padding: 10px 12px;
    font-weight: 500;
    font-size: 13px;
}
QPushButton[role="navItem"]:hover {
    background-color: rgba(234, 143, 174, 0.10);
    color: #6B4557;
}
QPushButton[role="navItem"]:checked {
    background-color: #FCE9F0;
    color: #D66A8C;
    border-left: 3px solid #EA8FAE;
    font-weight: 600;
}

QFrame#planCard {
    background-color: #FCE9F0;
    border: 1px solid #F8DCE8;
    border-radius: 14px;
}
QFrame#planCard QLabel { color: #B58CA0; font-size: 12px; }
QFrame#planCard QLabel[role="planTitle"] {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 13px;
    color: #6B4557;
}

/* ------------------------------------------------------------------ */
/* SIDEBAR NAV — bản dùng QListWidget (đúng với MainWindow.cpp thực tế) */
/* Thay cho khối QPushButton[role="navItem"] ở trên nếu bạn giữ         */
/* QListWidget#sidebarNav thay vì NavSidebar.h                          */
/* ------------------------------------------------------------------ */
QListWidget#sidebarNav {
    background-color: #FFF6F9;
    border: none;
    padding: 24px 12px;
    font-size: 13px;
}
QListWidget#sidebarNav::item {
    color: #B58CA0;
    padding: 11px 12px;
    margin: 2px 0;
    border-radius: 10px;
    border-left: 3px solid transparent;
    font-weight: 500;
}
QListWidget#sidebarNav::item:hover {
    background-color: rgba(234, 143, 174, 0.10);
    color: #6B4557;
}
QListWidget#sidebarNav::item:selected {
    background-color: #FCE9F0;
    color: #D66A8C;
    border-left: 3px solid #EA8FAE;
    font-weight: 600;
}
QListWidget#sidebarNav::item:selected:active,
QListWidget#sidebarNav::item:selected:!active {
    background-color: #FCE9F0; /* giữ màu active kể cả khi mất focus */
}

/* ------------------------------------------------------------------ */
/* TOPBAR                                                              */
/* LUU Y: topbar trong MainWindow.cpp la QWidget (khong phai QFrame),  */
/* nen selector phai la QWidget#topbar. QWidget can bat them thuoc     */
/* tinh Qt::WA_StyledBackground trong code de nhan background-color tu */
/* QSS (xem MainWindow.cpp). Nen trang de "lien" voi mau trang cua      */
/* sidebar (QWidget#sidebarWrap), tao cam giac 1 khoi thong nhat, chi   */
/* con duong line doc mong (border-right cua sidebarWrap) lam ranh gioi.*/
/* ------------------------------------------------------------------ */
QWidget#topbarWrap {
    background-color: #FFF6F9;
    border-bottom: 0.5px solid #F8DCE8;
}
QWidget#topbar {
    background-color: transparent;
}
QLabel[role="pageTitle"] {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 600;
    font-size: 18px;
    color: #6B4557;
}
QLabel[role="pageSub"] {
    font-size: 12px;
    color: #DCC0CE;
}

QLineEdit[role="searchBox"] {
    background-color: #FCE9F0;
    border: 1px solid #F8DCE8;
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 13px;
    color: #6B4557;
}
QLineEdit[role="searchBox"]:focus { border: 1px solid #F2A8C2; }

QToolButton[role="iconBtn"] {
    background-color: #FCE9F0;
    border: 1px solid #F8DCE8;
    border-radius: 10px;
    min-width: 38px; min-height: 38px;
}
QToolButton[role="iconBtn"]:hover { background-color: #F3C6D9; }

QLabel[role="avatar"] {
    background-color: #C9AEE8;
    color: #FFFFFF;
    border-radius: 10px;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 13px;
    qproperty-alignment: AlignCenter;
    min-width: 38px; min-height: 38px;
    max-width: 38px; max-height: 38px;
}

/* ------------------------------------------------------------------ */
/* CARD dùng chung (QFrame[cardStyle="true"])                          */
/* ------------------------------------------------------------------ */
QFrame[cardStyle="true"] {
    background-color: #FFF6F9;
    border: 1px solid #F8DCE8;
    border-radius: 18px;
}
QLabel[role="cardTitle"] {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 600;
    font-size: 15px;
    color: #6B4557;
}

/* Khung icon nhỏ 30x30 đặt trước card-title, đổi màu theo iconType */
QLabel[iconType="blue"]   { background-color: #FCE9F0; color: #D66A8C; border-radius: 9px; }
QLabel[iconType="green"]  { background-color: #DFF5EC; color: #4FA98A; border-radius: 9px; }
QLabel[iconType="orange"] { background-color: #FCE7D3; color: #D9915C; border-radius: 9px; }
QLabel[iconType="purple"] { background-color: #F1E9FB; color: #9B72D1; border-radius: 9px; }
QLabel[iconType="red"]    { background-color: #FBE1DC; color: #C96257; border-radius: 9px; }

/* ------------------------------------------------------------------ */
/* HERO CARD / STAT MINI / RANK ITEM (dùng ở tab Reports)              */
/* ------------------------------------------------------------------ */
QFrame[heroCard="true"] {
    border-radius: 20px;
    border: 1px solid #F8DCE8;
    background-color: #FCE9F0; /* dùng code set gradient thật nếu cần */
}
QFrame[statMini="true"] {
    background-color: #FFF6F9;
    border: 1px solid #F8DCE8;
    border-radius: 14px;
}
QLabel[role="statLabel"] { font-size: 11px; color: #DCC0CE; }
QLabel[role="statValue"] {
    font-family: "Space Grotesk", sans-serif; font-weight: 700; font-size: 20px; color: #6B4557;
}
QLabel[role="trendUp"]   { color: #4FA98A; font-weight: 600; font-size: 11px; }
QLabel[role="trendDown"] { color: #C96257; font-weight: 600; font-size: 11px; }

QFrame[rankItem="true"] {
    background-color: #FCE9F0;
    border: 1px solid #F8DCE8;
    border-radius: 13px;
}
QFrame[rankItem="top1"] {
    background-color: #FFF3DC;
    border: 1px solid #F0C68A;
}

/* ------------------------------------------------------------------ */
/* BUTTONS                                                             */
/* ------------------------------------------------------------------ */
QPushButton {
    border: none;
    border-radius: 10px;
    padding: 9px 16px;
    font-weight: 600;
    font-size: 12.5px;
}
QPushButton[variant="primary"] {
    background-color: #EA8FAE;
    color: #FFFFFF;
}
QPushButton[variant="primary"]:hover   { background-color: #F2A8C2; }
QPushButton[variant="primary"]:pressed { background-color: #D66A8C; }

QPushButton[variant="ghost"] {
    background-color: #FCE9F0;
    border: 1px solid #F3C6D9;
    color: #B58CA0;
}
QPushButton[variant="ghost"]:hover { background-color: #F3C6D9; }

QPushButton[variant="secondary"] {
    background-color: #FFF6F9;
    border: 1px solid #F2A8C2;
    color: #D66A8C;
}
QPushButton[variant="secondary"]:hover   { background-color: #FCE9F0; }
QPushButton[variant="secondary"]:pressed { background-color: #F3C6D9; }

QPushButton[variant="danger"] {
    background-color: #E2897C;
    color: #FFFFFF;
}
QPushButton[variant="danger"]:hover { background-color: #EAA396; }

/* ------------------------------------------------------------------ */
/* INPUTS / COMBOS                                                     */
/* ------------------------------------------------------------------ */
QLineEdit, QComboBox, QDateEdit, QSpinBox, QDoubleSpinBox {
    background-color: #FCE9F0;
    border: 1px solid #F3C6D9;
    border-radius: 9px;
    padding: 7px 12px;
    font-size: 12.5px;
    color: #6B4557;
    selection-background-color: #EA8FAE;
    selection-color: #FFFFFF;
}
QLineEdit:focus, QComboBox:focus, QDateEdit:focus { border: 1px solid #EA8FAE; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
    background-color: #FFF6F9;
    border: 1px solid #F3C6D9;
    selection-background-color: #EA8FAE;
    selection-color: #FFFFFF;
    outline: none;
}

/* ------------------------------------------------------------------ */
/* TABLES                                                              */
/* ------------------------------------------------------------------ */
QTableWidget, QTableView {
    background-color: #FFF6F9;
    alternate-background-color: #FCE9F0;
    border: 1px solid #F8DCE8;
    border-radius: 14px;
    gridline-color: #F8DCE8;
    selection-background-color: rgba(234, 143, 174, 0.18);
    selection-color: #6B4557;
}
QHeaderView {
    background-color: #FFF6F9;
}
QHeaderView::section {
    background-color: #FFF6F9;
    color: #B58CA0;
    font-size: 11px;
    font-weight: 700;
    padding: 10px;
    border: none;
    border-bottom: 1px solid #F8DCE8;
}
/* Cot STT (vertical header): can chinh rieng vi QHeaderView::section o tren
   dung chung cho ca header ngang lan doc. STT can canh giua, khong bold qua. */
QHeaderView::section:vertical {
    padding: 6px 10px;
    text-align: center;
}
/* O vuong nho tren-trai, giao giua header ngang va header doc — khong nam
   trong QHeaderView::section nen phai style rieng, neu khong se lo nen den mac dinh */
QTableCornerButton::section {
    background-color: #FFF6F9;
    border: none;
    border-bottom: 1px solid #F8DCE8;
}
QTableWidget::item { padding: 8px; }

/* ------------------------------------------------------------------ */
/* BOOKING VIEW — khung Room List (widget cuộn chứa các dòng Room)     */
/* LUU Y: roomsContainer la QWidget, can Qt::WA_StyledBackground trong  */
/* code (BookingView.cpp) de nhan duoc background-color o day.         */
/* ------------------------------------------------------------------ */
QWidget#roomListContainer {
    background-color: rgba(255, 255, 255, 0.35); /* lớp phủ sáng, nhẹ nhàng trên nền hồng dịu */
    border-radius: 10px;
}
QScrollArea#roomsScrollArea {
    background: transparent;
    border: none;
}

/* Nút "+" thêm phòng và nút "-" xoá phòng trong Room List: icon được vẽ
   trực tiếp bằng QPainter trong BookingView.cpp (không dùng ký tự text
   nữa vì dễ bị mất khi trùng màu nền), màu icon lấy đúng theo bảng màu:
     - addRoomBtn:    #D66A8C (--primary-prs)  — cùng tông variant="secondary"
     - removeRoomBtn: #C96257 (--coral text)   — cùng tông status Cancelled/Maintenance
   Hover riêng bên dưới chỉ đổi nền để làm nổi bật thao tác, không ảnh
   hưởng icon (icon là pixmap tĩnh, không đổi màu theo :hover). */
QPushButton#addRoomBtn:hover {
    background-color: #F3C6D9;
}
QPushButton#removeRoomBtn {
    border-color: #F3C6D9;
}
QPushButton#removeRoomBtn:hover {
    background-color: #FBE1DC;
    border-color: #F0B8AC;
}

/* ------------------------------------------------------------------ */
/* SCROLLBARS                                                          */
/* ------------------------------------------------------------------ */
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #F3C6D9; border-radius: 5px; min-height: 24px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

/* ------------------------------------------------------------------ */
/* STATUS BADGES (QLabel[status=...])                                   */
/* ------------------------------------------------------------------ */
QLabel[status="Available"]   { background-color: #DFF5EC; color: #4FA98A; border-radius: 10px; padding: 3px 10px; font-weight: 700; font-size: 11px; }
QLabel[status="Booked"]      { background-color: #FCE7D3; color: #D9915C; border-radius: 10px; padding: 3px 10px; font-weight: 700; font-size: 11px; }
QLabel[status="Maintenance"] { background-color: #FBE1DC; color: #C96257; border-radius: 10px; padding: 3px 10px; font-weight: 700; font-size: 11px; }
QLabel[status="Cancelled"]   { background-color: #FBE1DC; color: #C96257; border-radius: 10px; padding: 3px 10px; font-weight: 700; font-size: 11px; }
QLabel[status="Checked-in"]  { background-color: #FCE9F0; color: #D66A8C; border-radius: 10px; padding: 3px 10px; font-weight: 700; font-size: 11px; }
QLabel[status="Checked-out"] { background-color: #FFF6F9; color: #B58CA0; border-radius: 10px; padding: 3px 10px; font-weight: 700; font-size: 11px; }

/ ----------------------------------------
/ ReceptionistView
/ -----------------------------------------
QLabel[tier="excellent"] { background:#DFF5EC; color:#4FA98A; border-radius:10px; padding:3px 10px; font-weight:700; }
QLabel[tier="good"]      { background:#F1E9FB; color:#9B72D1; border-radius:10px; padding:3px 10px; font-weight:700; }
QLabel[tier="average"]   { background:#FCE7D3; color:#D9915C; border-radius:10px; padding:3px 10px; font-weight:700; }


// -----------------------------------------
// ReportView
// --------------------------------------
QFrame[rankItem="true"] { background:#FCE9F0; border-radius:12px; }
QFrame[rankItem="true"][topRank="true"] { background:qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #FFF3DC, stop:1 #FFEBD1); border:1px solid #F0C68A; }
QLabel[role="rankNumber"] { background:#FFF6F9; border-radius:8px; font-weight:700; color:#B58CA0; }
QFrame[rankItem="true"][topRank="true"] QLabel[role="rankNumber"] { background:qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #F0B45E, stop:1 #F5945C); color:#fff; }
QLabel[role="rankName"] { font-weight:600; font-size:13px; }
QLabel[role="rankId"] { color:#DCC0CE; font-size:10.5px; }
QLabel[role="rankAmount"] { font-weight:700; color:#4FA98A; }
