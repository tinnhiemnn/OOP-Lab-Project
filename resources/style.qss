/* =====================================================================
   LuxeStay HMS — LIGHT THEME (chuyển thể từ hotel_dashboard_mockup_light.html)
   Dán/replace nội dung này vào: resources/style.qss
   ---------------------------------------------------------------------
   Bảng màu gốc (biến CSS trong mockup -> giá trị hex dùng lại ở đây):
     --bg        #F5F7FA   nền cửa sổ
     --card      #FFFFFF   nền card
     --card-2    #F1F5F9   nền input / nút ghost
     --border    #E4E9F0   viền nhạt
     --border-s  #D2D9E4   viền đậm hơn (input, select)
     --text      #0F172A   chữ chính
     --text-dim  #64748B   chữ phụ
     --text-faint#94A3B8   chữ mờ / placeholder
     --blue      #2563EB   --purple  #7C3AED
     --teal      #0D9488   --orange  #EA580C
     --gold      #D97706   --red     #E11D48
   Qt Style Sheets KHÔNG hỗ trợ box-shadow / border-radius theo %.
   Đổ bóng cho card -> dùng QGraphicsDropShadowEffect trong code (xem
   HUONG_DAN_TICH_HOP_QT.md, mục 4).
   ===================================================================== */

* {
    font-family: "Inter", "Segoe UI", sans-serif;
    color: #0F172A;
    outline: none;
}

QMainWindow, QWidget#centralWidget {
    background-color: #F5F7FA;
}

/* ------------------------------------------------------------------ */
/* SIDEBAR (thay cho QTabWidget mặc định)                              */
/* ------------------------------------------------------------------ */
QFrame#sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E4E9F0;
}

QLabel#brandMark {
    border-radius: 10px;
    background-color: #2563EB; /* fallback phẳng, gradient thật set bằng code nếu muốn */
    color: #FFFFFF;
    font-weight: 700;
}

QLabel#brandName {
    font-family: "Space Grotesk", "Inter", sans-serif;
    font-weight: 700;
    font-size: 15px;
    color: #0F172A;
}

QLabel#brandSub {
    font-size: 11px;
    color: #94A3B8;
}

QLabel[role="navLabel"] {
    font-size: 11px;
    font-weight: 700;
    color: #94A3B8;
    padding: 10px 4px 2px;
}

/* Nav item = QPushButton (checkable, flat) */
QPushButton[role="navItem"] {
    text-align: left;
    background-color: transparent;
    color: #64748B;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 10px;
    padding: 10px 12px;
    font-weight: 500;
    font-size: 13px;
}
QPushButton[role="navItem"]:hover {
    background-color: rgba(15, 23, 42, 0.035);
    color: #0F172A;
}
QPushButton[role="navItem"]:checked {
    background-color: #EFF4FF;
    color: #2563EB;
    border-left: 3px solid #2563EB;
    font-weight: 600;
}

QFrame#planCard {
    background-color: #EFF4FF;
    border: 1px solid #E4E9F0;
    border-radius: 14px;
}
QFrame#planCard QLabel { color: #64748B; font-size: 12px; }
QFrame#planCard QLabel[role="planTitle"] {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 13px;
    color: #0F172A;
}

/* ------------------------------------------------------------------ */
/* SIDEBAR NAV — bản dùng QListWidget (đúng với MainWindow.cpp thực tế) */
/* Thay cho khối QPushButton[role="navItem"] ở trên nếu bạn giữ         */
/* QListWidget#sidebarNav thay vì NavSidebar.h                          */
/* ------------------------------------------------------------------ */
QListWidget#sidebarNav {
    background-color: #FFFFFF;
    border: none;
    border-right: 1px solid #E4E9F0;
    padding: 24px 12px;
    font-size: 13px;
}
QListWidget#sidebarNav::item {
    color: #64748B;
    padding: 11px 12px;
    margin: 2px 0;
    border-radius: 10px;
    border-left: 3px solid transparent;
    font-weight: 500;
}
QListWidget#sidebarNav::item:hover {
    background-color: rgba(15, 23, 42, 0.035);
    color: #0F172A;
}
QListWidget#sidebarNav::item:selected {
    background-color: #EFF4FF;
    color: #2563EB;
    border-left: 3px solid #2563EB;
    font-weight: 600;
}
QListWidget#sidebarNav::item:selected:active,
QListWidget#sidebarNav::item:selected:!active {
    background-color: #EFF4FF; /* giữ màu active kể cả khi mất focus */
}

/* ------------------------------------------------------------------ */
/* TOPBAR                                                              */
/* ------------------------------------------------------------------ */
QFrame#topbar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E4E9F0;
}
QLabel[role="pageTitle"] {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 600;
    font-size: 18px;
    color: #0F172A;
}
QLabel[role="pageSub"] {
    font-size: 12px;
    color: #94A3B8;
}

QLineEdit[role="searchBox"] {
    background-color: #F1F5F9;
    border: 1px solid #E4E9F0;
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 13px;
    color: #0F172A;
}
QLineEdit[role="searchBox"]:focus { border: 1px solid #93B4F7; }

QToolButton[role="iconBtn"] {
    background-color: #F1F5F9;
    border: 1px solid #E4E9F0;
    border-radius: 10px;
    min-width: 38px; min-height: 38px;
}
QToolButton[role="iconBtn"]:hover { background-color: #E9EEF5; }

QLabel[role="avatar"] {
    background-color: #7C3AED;
    color: #FFFFFF;
    border-radius: 10px;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 13px;
    qproperty-alignment: AlignCenter;
    min-width: 38px; min-height: 38px;
    max-width: 38px; max-height: 38px;
}

/* ------------------------------------------------------------------ */
/* CARD dùng chung (QFrame[cardStyle="true"])                          */
/* ------------------------------------------------------------------ */
QFrame[cardStyle="true"] {
    background-color: #FFFFFF;
    border: 1px solid #E4E9F0;
    border-radius: 18px;
}
QLabel[role="cardTitle"] {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 600;
    font-size: 15px;
    color: #0F172A;
}

/* Khung icon nhỏ 30x30 đặt trước card-title, đổi màu theo iconType */
QLabel[iconType="blue"]   { background-color: #EFF4FF; color: #2563EB; border-radius: 9px; }
QLabel[iconType="green"]  { background-color: #EDFAF8; color: #0D9488; border-radius: 9px; }
QLabel[iconType="orange"] { background-color: #FFF4EB; color: #EA580C; border-radius: 9px; }
QLabel[iconType="purple"] { background-color: #F5F1FF; color: #7C3AED; border-radius: 9px; }
QLabel[iconType="red"]    { background-color: #FEF1F3; color: #E11D48; border-radius: 9px; }

/* ------------------------------------------------------------------ */
/* HERO CARD / STAT MINI / RANK ITEM (dùng ở tab Reports)              */
/* ------------------------------------------------------------------ */
QFrame[heroCard="true"] {
    border-radius: 20px;
    border: 1px solid #E4E9F0;
    background-color: #EFF4FF; /* dùng code set gradient thật nếu cần */
}
QFrame[statMini="true"] {
    background-color: #FFFFFF;
    border: 1px solid #E4E9F0;
    border-radius: 14px;
}
QLabel[role="statLabel"] { font-size: 11px; color: #94A3B8; }
QLabel[role="statValue"] {
    font-family: "Space Grotesk", sans-serif; font-weight: 700; font-size: 20px; color: #0F172A;
}
QLabel[role="trendUp"]   { color: #0F766E; font-weight: 600; font-size: 11px; }
QLabel[role="trendDown"] { color: #E11D48; font-weight: 600; font-size: 11px; }

QFrame[rankItem="true"] {
    background-color: #F1F5F9;
    border: 1px solid #E4E9F0;
    border-radius: 13px;
}
QFrame[rankItem="top1"] {
    background-color: #FFF7E6;
    border: 1px solid #F3D28A;
}

/* ------------------------------------------------------------------ */
/* BUTTONS                                                             */
/* ------------------------------------------------------------------ */
QPushButton {
    border: none;
    border-radius: 10px;
    padding: 9px 16px;
    font-weight: 600;
    font-size: 12.5px;
}
QPushButton[variant="primary"] {
    background-color: #2563EB;
    color: #FFFFFF;
}
QPushButton[variant="primary"]:hover   { background-color: #3B7BF0; }
QPushButton[variant="primary"]:pressed { background-color: #1D4ED8; }

QPushButton[variant="ghost"] {
    background-color: #F1F5F9;
    border: 1px solid #D2D9E4;
    color: #64748B;
}
QPushButton[variant="ghost"]:hover { background-color: #E9EEF5; }

QPushButton[variant="secondary"] {
    background-color: #EFF4FF;
    border: 1px solid #93B4F7;
    color: #2563EB;
}
QPushButton[variant="secondary"]:hover   { background-color: #E1EAFE; }
QPushButton[variant="secondary"]:pressed { background-color: #D3E0FC; }

QPushButton[variant="danger"] {
    background-color: #E11D48;
    color: #FFFFFF;
}
QPushButton[variant="danger"]:hover { background-color: #F43F5E; }

/* ------------------------------------------------------------------ */
/* INPUTS / COMBOS                                                     */
/* ------------------------------------------------------------------ */
QLineEdit, QComboBox, QDateEdit, QSpinBox, QDoubleSpinBox {
    background-color: #F1F5F9;
    border: 1px solid #D2D9E4;
    border-radius: 9px;
    padding: 7px 12px;
    font-size: 12.5px;
    color: #0F172A;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}
QLineEdit:focus, QComboBox:focus, QDateEdit:focus { border: 1px solid #2563EB; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #D2D9E4;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
    outline: none;
}

/* ------------------------------------------------------------------ */
/* TABLES                                                              */
/* ------------------------------------------------------------------ */
QTableWidget, QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #FAFBFD;
    border: 1px solid #E4E9F0;
    border-radius: 14px;
    gridline-color: #E4E9F0;
    selection-background-color: rgba(37, 99, 235, 0.12);
    selection-color: #0F172A;
}
QHeaderView::section {
    background-color: #FFFFFF;
    color: #94A3B8;
    font-size: 11px;
    font-weight: 700;
    padding: 10px;
    border: none;
    border-bottom: 1px solid #E4E9F0;
}
QTableWidget::item { padding: 8px; }

/* ------------------------------------------------------------------ */
/* SCROLLBARS                                                          */
/* ------------------------------------------------------------------ */
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #C7CEDA; border-radius: 5px; min-height: 24px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

/* ------------------------------------------------------------------ */
/* STATUS BADGES (QLabel[status=...])                                   */
/* ------------------------------------------------------------------ */
QLabel[status="Available"]   { background-color: #EDFAF8; color: #0F766E; border-radius: 10px; padding: 3px 10px; font-weight: 700; font-size: 11px; }
QLabel[status="Booked"]      { background-color: #FFF4EB; color: #C2410C; border-radius: 10px; padding: 3px 10px; font-weight: 700; font-size: 11px; }
QLabel[status="Maintenance"] { background-color: #FEF1F3; color: #BE123C; border-radius: 10px; padding: 3px 10px; font-weight: 700; font-size: 11px; }
QLabel[status="Cancelled"]   { background-color: #FEF1F3; color: #BE123C; border-radius: 10px; padding: 3px 10px; font-weight: 700; font-size: 11px; }
QLabel[status="Checked-in"]  { background-color: #EFF4FF; color: #2563EB; border-radius: 10px; padding: 3px 10px; font-weight: 700; font-size: 11px; }
QLabel[status="Checked-out"] { background-color: #F1F5F9; color: #64748B; border-radius: 10px; padding: 3px 10px; font-weight: 700; font-size: 11px; }

/ ----------------------------------------
/ ReceptionistView
/ -----------------------------------------
QLabel[tier="excellent"] { background:#ECFDF5; color:#047857; border-radius:10px; padding:3px 10px; font-weight:700; }
QLabel[tier="good"]      { background:#EFF6FF; color:#1D4ED8; border-radius:10px; padding:3px 10px; font-weight:700; }
QLabel[tier="average"]   { background:#FFF7ED; color:#C2410C; border-radius:10px; padding:3px 10px; font-weight:700; }


// -----------------------------------------
// ReportView
// --------------------------------------
QFrame[rankItem="true"] { background:#F1F5F9; border-radius:12px; }
QFrame[rankItem="true"][topRank="true"] { background:qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #FFF7E6, stop:1 #FFF1E0); border:1px solid #F3D28A; }
QLabel[role="rankNumber"] { background:#FFFFFF; border-radius:8px; font-weight:700; color:#64748B; }
QFrame[rankItem="true"][topRank="true"] QLabel[role="rankNumber"] { background:qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #F59E0B, stop:1 #EA580C); color:#fff; }
QLabel[role="rankName"] { font-weight:600; font-size:13px; }
QLabel[role="rankId"] { color:#94A3B8; font-size:10.5px; }
QLabel[role="rankAmount"] { font-weight:700; color:#0F766E; }